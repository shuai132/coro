cmake_minimum_required(VERSION 3.15)

if (COMPILER_ID STREQUAL "MSVC")
    set(flags /nologo /std:c++20 /Zc:preprocessor /EHsc /E "/I${INCLUDE_DIR}")
    set(define_prefix /D)
else ()
    set(flags -std=c++20 -fexceptions -E "-I${INCLUDE_DIR}")
    set(define_prefix -D)
    if (COMPILER_ID STREQUAL "GNU" AND COMPILER_VERSION VERSION_LESS 11)
        list(APPEND flags -fcoroutines)
    endif ()
endif ()
list(APPEND flags "${define_prefix}NOMINMAX")
if (WIN32)
    list(APPEND flags "${define_prefix}_WIN32_WINNT=0x0601")
endif ()
if (DISABLE_EXCEPTION)
    list(APPEND flags "${define_prefix}CORO_DISABLE_EXCEPTION")
endif ()
if (NOT "${ASIO_INCLUDE_DIR}" STREQUAL "")
    list(APPEND flags "${define_prefix}CORO_TEST_WITH_ASIO")
    if (COMPILER_ID STREQUAL "MSVC")
        list(APPEND flags "/I${ASIO_INCLUDE_DIR}")
    else ()
        list(APPEND flags "-I${ASIO_INCLUDE_DIR}")
    endif ()
endif ()

set(output "${BINARY_DIR}/noexcept-source-${DISABLE_EXCEPTION}.ii")
execute_process(
    COMMAND "${COMPILER}" ${flags} "${SOURCE}"
    OUTPUT_FILE "${output}"
    ERROR_VARIABLE error
    RESULT_VARIABLE result
)
if (NOT result EQUAL 0)
    message(FATAL_ERROR "Exception-source preprocessing failed:\n${error}")
endif ()

# Only inspect this library's source; standard-library and ASIO internals have their own configuration.
file(STRINGS "${output}" lines)
set(in_library OFF)
set(library_lines 0)
set(handler_lines 0)
foreach (line IN LISTS lines)
    if (line MATCHES "^#[ \t]*(line[ \t]+)?[0-9]+[ \t]+\"([^\"]+)\"")
        string(REPLACE "\\" "/" header "${CMAKE_MATCH_2}")
        if (header MATCHES "/include/+coro/" OR header MATCHES "/include/+coro\\.hpp$")
            set(in_library ON)
        else ()
            set(in_library OFF)
        endif ()
    elseif (in_library)
        math(EXPR library_lines "${library_lines} + 1")
        string(REGEX REPLACE "\"([^\"\\\\]|\\\\.)*\"" "\"\"" code "${line}")
        if (code MATCHES "(^|[^A-Za-z0-9_])(try|catch|throw)([^A-Za-z0-9_]|$)" OR
            code MATCHES "std::(exception_ptr|current_exception|rethrow_exception)")
            math(EXPR handler_lines "${handler_lines} + 1")
            if (DISABLE_EXCEPTION)
                message(FATAL_ERROR "CORO_DISABLE_EXCEPTION retained exception handling in ${header}:\n${line}")
            endif ()
        endif ()
    endif ()
endforeach ()
if (library_lines EQUAL 0)
    message(FATAL_ERROR "No library source was inspected")
endif ()
if (NOT DISABLE_EXCEPTION AND handler_lines EQUAL 0)
    message(FATAL_ERROR "The control configuration must retain exception handling")
endif ()
message(STATUS "Exception-source regression passed: disabled=${DISABLE_EXCEPTION}, handler lines=${handler_lines}")
